# Which network the app talks to: "robinhood" (mainnet, chain 4663) or "fork" (local anvil fork, chain 31337)
NEXT_PUBLIC_CHAIN=robinhood

# Optional dedicated RPC (the public one is rate-limited)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Local fork RPC (used when NEXT_PUBLIC_CHAIN=fork)
NEXT_PUBLIC_FORK_RPC_URL=http://127.0.0.1:8547

# WalletConnect Cloud project id (https://cloud.reown.com). Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# $SLCE project token address. EMPTY = all token features hidden. Set after the launchpad launch AND after
# the Timelock has executed ProjectTokenHooks.setProjectToken(address).
NEXT_PUBLIC_PROJECT_TOKEN=

# Optional geoblock: comma-separated ISO-3166 alpha-2 country codes (uses Vercel's x-vercel-ip-country header)
BLOCKED_COUNTRIES=

# Max block range per eth_getLogs request when building payslip CSVs
NEXT_PUBLIC_LOG_CHUNK=500000
